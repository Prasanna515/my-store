---
const { title = 'My Electronics Store' } = Astro.props;
const q = Astro.url.searchParams.get('q') ?? '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <style is:global>
    :root { --brand:#0b5ed7; --ink:#1b1f24; --muted:#6b7280; --line:#e5e7eb; --bg:#f8fafc; }
    * { box-sizing:border-box; }
    body { margin:0; font-family:system-ui,Arial,sans-serif; color:var(--ink); background:var(--bg); }
    a { color:inherit; text-decoration:none; }
    header { background:#fff; border-bottom:1px solid var(--line); padding:12px 16px; display:flex; gap:16px; align-items:center; flex-wrap:wrap; position:sticky; top:0; z-index:5; }
    .logo { font-weight:700; font-size:20px; color:var(--brand); }
    .cat-menu-wrap { position:relative; }
    .cat-menu-btn { background:#fff; color:var(--ink); border:1px solid var(--line); border-radius:8px; padding:10px 14px; font-size:15px; cursor:pointer; display:flex; align-items:center; gap:8px; white-space:nowrap; }
    .cat-panel { position:absolute; top:calc(100% + 6px); left:0; width:300px; max-height:70vh; overflow-y:auto; background:#fff; border:1px solid var(--line); border-radius:10px; box-shadow:0 8px 24px rgba(0,0,0,0.08); z-index:30; display:none; }
    .cat-panel.open { display:block; }
    .cat-row { display:flex; justify-content:space-between; align-items:center; padding:12px 16px; border-bottom:1px solid #f1f5f9; cursor:pointer; font-weight:600; color:var(--ink); }
    .cat-row:hover { background:#f8fafc; }
    .cat-row .chev { transition:transform 0.15s; color:var(--muted); }
    .cat-row.expanded .chev { transform:rotate(90deg); }
    .cat-sub-list { display:none; background:#f8fafc; }
    .cat-sub-list.open { display:block; }
    .cat-sub-row, .cat-viewall-row { display:block; padding:10px 16px 10px 28px; font-size:14px; color:var(--ink); border-bottom:1px solid #eef2f7; }
    .cat-sub-row:hover, .cat-viewall-row:hover { background:#eef2f7; }
    .cat-viewall-row { color:var(--brand); font-weight:600; font-size:13px; }
    form.search { flex:1; min-width:220px; display:flex; gap:8px; position:relative; }
    form.search input { flex:1; padding:10px 12px; border:1px solid var(--line); border-radius:8px; font-size:15px; }
    .search-dropdown { position:absolute; top:calc(100% + 6px); left:0; right:0; background:#fff; border:1px solid var(--line); border-radius:10px; box-shadow:0 8px 24px rgba(0,0,0,0.08); max-height:400px; overflow-y:auto; z-index:20; display:none; }
    .search-dropdown.open { display:block; }
    .search-row { display:flex; gap:10px; align-items:center; padding:8px 12px; border-bottom:1px solid #f1f5f9; cursor:pointer; }
    .search-row:hover { background:#f8fafc; }
    .search-row:last-child { border-bottom:none; }
    .search-thumb { width:40px; height:40px; border-radius:6px; background:#eef2f7; display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0; }
    .search-thumb img { width:100%; height:100%; object-fit:contain; }
    .search-info { flex:1; min-width:0; }
    .search-name { font-size:14px; line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .search-meta { font-size:12px; color:var(--muted); }
    .search-price { font-size:14px; font-weight:700; white-space:nowrap; }
    .search-empty { padding:12px; color:var(--muted); font-size:14px; }
    .recent-label { padding:8px 12px 4px; font-size:12px; color:var(--muted); display:flex; justify-content:space-between; }
    .recent-clear { color:var(--brand); cursor:pointer; }
    .recent-row { padding:8px 12px; font-size:14px; cursor:pointer; }
    .recent-row:hover { background:#f8fafc; }
    button, .btn { background:var(--brand); color:#fff; border:0; border-radius:8px; padding:10px 16px; font-size:15px; cursor:pointer; }
    main { max-width:1150px; margin:0 auto; padding:16px; }
    .chips { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; }
    .chip { background:#fff; border:1px solid var(--line); border-radius:20px; padding:6px 14px; font-size:14px; }
    .chip.on { background:var(--brand); color:#fff; border-color:var(--brand); }
    .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:14px; }
    .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:10px; display:flex; flex-direction:column; gap:6px; transition:box-shadow 0.15s, transform 0.15s; }
    .card:hover { box-shadow:0 6px 16px rgba(0,0,0,0.08); transform:translateY(-2px); }
    .img { aspect-ratio:1; background:#eef2f7; border-radius:8px; display:grid; place-items:center; color:var(--muted); font-size:12px; overflow:hidden; }
    .img img { width:100%; height:100%; object-fit:contain; }
    .name { font-size:14px; line-height:1.3; }
    .price { font-weight:700; } .mrp { color:var(--muted); text-decoration:line-through; font-size:13px; margin-left:6px; }
    .off { color:#15803d; font-size:13px; } .out { color:#b91c1c; font-size:13px; }
    .detail { display:grid; grid-template-columns:1fr; gap:24px; background:#fff; padding:16px; border-radius:10px; border:1px solid var(--line); }
    @media (min-width:768px){ .detail { grid-template-columns:1fr 1fr; } }
    footer { background:#f1f5f9; border-top:1px solid var(--line); margin-top:40px; }
    .footer-grid { max-width:1150px; margin:0 auto; padding:32px 16px; display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:24px; }
    .footer-col h4 { margin:0 0 10px; font-size:15px; }
    .footer-col a { display:block; color:var(--ink); text-decoration:none; padding:4px 0; font-size:14px; }
    .footer-col a:hover { color:var(--brand); }
    .footer-bottom { border-top:1px solid var(--line); padding:16px; text-align:center; font-size:13px; color:var(--muted); }

    .mobile-nav { display:none; }
    @media (max-width:640px) {
      header { padding:10px 12px; gap:10px; }
      .logo { font-size:17px; }
      #header-orders, #header-wishlist, #header-account, #header-cart { display:none; }
      .cat-menu-btn .cat-label { display:none; }
      main { padding-bottom:76px; }
      .mobile-nav {
        display:flex; position:fixed; left:0; right:0; bottom:0; background:#fff;
        border-top:1px solid var(--line); z-index:40; padding-bottom:env(safe-area-inset-bottom,0px);
      }
      .mnav-item {
        flex:1; display:flex; flex-direction:column; align-items:center; gap:2px;
        color:var(--muted); text-decoration:none; font-size:11px; padding:8px 0 6px;
        background:none; border:0; font-family:inherit; cursor:pointer;
      }
      .mnav-item .icon { font-size:19px; line-height:1; position:relative; display:inline-block; }
      .mnav-item.active { color:var(--brand); }
      .mnav-badge {
        position:absolute; top:-6px; right:-10px; background:var(--brand); color:#fff;
        font-size:10px; font-weight:700; line-height:1; border-radius:999px; padding:2px 5px; min-width:14px; text-align:center;
      }
      .chips { flex-wrap:nowrap; overflow-x:auto; -webkit-overflow-scrolling:touch; padding-bottom:4px; }
      .chip { flex-shrink:0; }
      input, select, button, .btn { font-size:16px; } /* prevents iOS auto-zoom on focus */
    }
    @media (max-width:480px) {
      #checkout-form button[type=submit], #login-form button, #signup-form button { width:100%; }
    }
  </style>
</head>
<body>
  <header>
    <a class="logo" href="/">⚡ My Electronics Store</a>
    <div class="cat-menu-wrap">
      <button class="cat-menu-btn" id="cat-menu-btn" type="button">☰ <span class="cat-label">All Categories</span> <span style="font-size:11px">▾</span></button>
      <div class="cat-panel" id="cat-panel"></div>
    </div>
    <form class="search" action="/" method="get" id="search-form">
      <input name="q" id="search-input" value={q} placeholder="Search parts, e.g. ESP32, HC-SR04, L298N" autocomplete="off" />
      <button type="submit">Search</button>
      <div class="search-dropdown" id="search-dropdown"></div>
    </form>
    <a href="/account/orders" id="header-orders" class="btn" style="background:#fff;color:var(--ink);border:1px solid var(--line)" title="My Orders">📦</a>
    <a href="/account" id="header-account" class="btn" style="background:#fff;color:var(--ink);border:1px solid var(--line)" title="My Account">👤</a>
    <a href="/account/wishlist" id="header-wishlist" class="btn" style="background:#fff;color:var(--ink);border:1px solid var(--line)" title="My Wishlist">♡</a>
    <a href="/cart" id="header-cart" class="btn" style="background:#fff;color:var(--brand);border:1px solid var(--brand)">🛒 Cart (<span data-cart-count>0</span>)</a>
  </header>
  <main><slot /></main>
  <nav class="mobile-nav">
    <a href="/" class="mnav-item"><span class="icon">🏠</span>Home</a>
    <a href="/account/wishlist" class="mnav-item"><span class="icon">♡</span>Wishlist</a>
    <a href="/cart" class="mnav-item"><span class="icon">🛒<span class="mnav-badge" data-cart-count>0</span></span>Cart</a>
    <a href="/account/orders" class="mnav-item"><span class="icon">📦</span>Orders</a>
    <a href="/account" class="mnav-item"><span class="icon">👤</span>Account</a>
  </nav>
  <footer>
    <div class="footer-grid">
      <div class="footer-col">
        <h4>Information</h4>
        <a href="/track-order">Track Your Order</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact Us</a>
      </div>
      <div class="footer-col">
        <h4>My Account</h4>
        <a href="/cart">Cart</a>
        <a href="/checkout">Checkout</a>
        <a href="/account">My Account</a>
        <a href="/account/orders">My Orders</a>
      </div>
      <div class="footer-col">
        <h4>Policies</h4>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/shipping-refund">Shipping &amp; Refund</a>
      </div>
      <div class="footer-col">
        <h4>Got Questions?</h4>
        <p style="font-size:14px;color:var(--muted);margin:0 0 8px">Email us anytime</p>
        <a href="/contact">your-email@example.com</a>
      </div>
    </div>
    <div class="footer-bottom">
      We accept UPI · Cards · Net Banking · Cash on Delivery (via Razorpay)
      <br />© <span id="footer-year"></span> My Electronics Store. All rights reserved.
    </div>
  </footer>
  <script>
    import { updateCartBadge } from '../lib/cart-client.js';
    import { getBrowserSupabase } from '../lib/supabase-browser.js';
    updateCartBadge();
    const yearEl = document.getElementById('footer-year');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());

    (async () => {
      try {
        const supabase = await getBrowserSupabase();
        const {
          data: { session },
        } = await supabase.auth.getSession();
        const link = document.getElementById('header-account');
        if (session && link) link.title = session.user.email;
      } catch {
        // not logged in / config not reachable — icon just stays as-is
      }
    })();

    const catBtn = document.getElementById('cat-menu-btn');
    const catPanel = document.getElementById('cat-panel');
    let catsLoaded = false;

    function renderCategoryPanel(parents, children) {
      catPanel.innerHTML =
        `<a class="cat-row" href="/" style="display:block">All Products</a>` +
        parents
          .map(
            (p) => `
        <div>
          <div class="cat-row" data-id="${p.id}"><span>${p.name}</span><span class="chev">›</span></div>
          <div class="cat-sub-list" data-sub-for="${p.id}">
            <a class="cat-viewall-row" href="/?cat=${p.id}">View all ${p.name}</a>
            ${(children[p.id] || []).map((c) => `<a class="cat-sub-row" href="/?cat=${c.id}">${c.name}</a>`).join('')}
          </div>
        </div>`
          )
          .join('');

      catPanel.querySelectorAll('.cat-row[data-id]').forEach((row) => {
        row.addEventListener('click', () => {
          const id = row.dataset.id;
          const sub = catPanel.querySelector(`.cat-sub-list[data-sub-for="${id}"]`);
          const isOpen = sub.classList.contains('open');
          catPanel.querySelectorAll('.cat-sub-list.open').forEach((s) => s.classList.remove('open'));
          catPanel.querySelectorAll('.cat-row.expanded').forEach((r) => r.classList.remove('expanded'));
          if (!isOpen) {
            sub.classList.add('open');
            row.classList.add('expanded');
          }
        });
      });
    }

    async function loadCategoryPanel() {
      if (catsLoaded) return;
      catPanel.innerHTML = '<div class="search-empty">Loading…</div>';
      try {
        const res = await fetch('/api/categories');
        const data = await res.json();
        renderCategoryPanel(data.parents || [], data.children || {});
        catsLoaded = true;
      } catch {
        catPanel.innerHTML = '<div class="search-empty">Could not load categories.</div>';
      }
    }

    catBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !catPanel.classList.contains('open');
      catPanel.classList.toggle('open');
      if (willOpen) loadCategoryPanel();
    });
    document.addEventListener('click', (e) => {
      if (!catBtn.contains(e.target) && !catPanel.contains(e.target)) catPanel.classList.remove('open');
    });

    const RECENT_KEY = 'recent_searches_v1';
    const input = document.getElementById('search-input');
    const dropdown = document.getElementById('search-dropdown');
    const form = document.getElementById('search-form');

    function getRecent() {
      try { return JSON.parse(localStorage.getItem(RECENT_KEY)) || []; } catch { return []; }
    }
    function addRecent(term) {
      term = term.trim();
      if (!term) return;
      let recent = getRecent().filter((t) => t.toLowerCase() !== term.toLowerCase());
      recent.unshift(term);
      recent = recent.slice(0, 5);
      localStorage.setItem(RECENT_KEY, JSON.stringify(recent));
    }
    function clearRecent() {
      localStorage.removeItem(RECENT_KEY);
    }

    function rupees(n) {
      return '₹' + Number(n).toLocaleString('en-IN');
    }

    function openDropdown() {
      dropdown.classList.add('open');
    }
    function closeDropdown() {
      dropdown.classList.remove('open');
    }

    function renderRecent() {
      const recent = getRecent();
      if (recent.length === 0) {
        dropdown.innerHTML = '';
        closeDropdown();
        return;
      }
      dropdown.innerHTML =
        `<div class="recent-label"><span>Recent searches</span><span class="recent-clear" id="recent-clear-btn">Clear</span></div>` +
        recent.map((t) => `<div class="recent-row" data-term="${t.replace(/"/g, '&quot;')}">🕘 ${t}</div>`).join('');
      openDropdown();
      document.getElementById('recent-clear-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        clearRecent();
        renderRecent();
      });
      dropdown.querySelectorAll('.recent-row').forEach((row) => {
        row.addEventListener('click', () => {
          input.value = row.dataset.term;
          form.submit();
        });
      });
    }

    function renderResults(results) {
      if (results.length === 0) {
        dropdown.innerHTML = '<div class="search-empty">No products found.</div>';
        openDropdown();
        return;
      }
      dropdown.innerHTML = results
        .map(
          (p) => `
        <a class="search-row" href="/product/${p.slug}">
          <div class="search-thumb">${p.image_url ? `<img src="${p.image_url}" alt="" />` : '📦'}</div>
          <div class="search-info">
            <div class="search-name">${p.name}</div>
            <div class="search-meta">${p.sku}${p.stock <= 0 ? ' · Out of stock' : ''}</div>
          </div>
          <div class="search-price">${rupees(p.selling_price)}</div>
        </a>`
        )
        .join('');
      openDropdown();
    }

    let debounceTimer;
    input.addEventListener('input', () => {
      const term = input.value.trim();
      clearTimeout(debounceTimer);
      if (term.length === 0) {
        renderRecent();
        return;
      }
      if (term.length < 2) {
        closeDropdown();
        return;
      }
      debounceTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(term)}`);
          const data = await res.json();
          renderResults(data.results || []);
        } catch {
          closeDropdown();
        }
      }, 250);
    });

    input.addEventListener('focus', () => {
      if (input.value.trim().length === 0) renderRecent();
    });

    form.addEventListener('submit', () => {
      addRecent(input.value);
    });

    document.addEventListener('click', (e) => {
      if (!form.contains(e.target)) closeDropdown();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDropdown();
    });
  </script>
</body>
</html>
