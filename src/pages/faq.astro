---
import Layout from '../layouts/Layout.astro';
const faqs = [
  { q: 'What payment methods do you accept?', a: 'We accept UPI, credit/debit cards, and net banking via Razorpay, as well as Cash on Delivery where available.' },
  { q: 'How long does delivery take?', a: 'Orders are typically shipped within 1–2 business days and delivered within 4–7 business days across India, depending on your location.' },
  { q: 'Can I cancel or return an order?', a: 'Please see our Shipping & Refund Policy page for details on cancellations, returns, and refunds.' },
  { q: 'How do I track my order?', a: 'Use the "Track Your Order" link in the footer with your order number and phone number.' },
  { q: 'Is Cash on Delivery always available?', a: 'COD availability may vary by order value and location, and is occasionally paused. If it isn\u2019t offered at checkout, please pay online instead.' },
];
---
<Layout title="FAQ | My Electronics Store">
  <h1>Frequently Asked Questions</h1>
  <div style="max-width:640px">
    {faqs.map((f) => (
      <div style="background:#fff;padding:16px;border-radius:10px;border:1px solid var(--line);margin-bottom:10px">
        <b>{f.q}</b>
        <p style="margin:8px 0 0;color:var(--muted)">{f.a}</p>
      </div>
    ))}
  </div>
  <p style="color:var(--muted);font-size:13px;max-width:640px">
    (Store owner note: this is a starter FAQ — edit the questions and answers in src/pages/faq.astro to match your actual policies.)
  </p>
</Layout>
