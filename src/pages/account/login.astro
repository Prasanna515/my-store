---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Log In | My Electronics Store">
  <div style="max-width:360px;margin:40px auto;background:#fff;padding:24px;border-radius:10px;border:1px solid var(--line)">
    <h1>Log In</h1>
    <form id="login-form" style="display:flex;flex-direction:column;gap:10px">
      <input type="email" name="email" placeholder="Email" required style="padding:10px;border:1px solid var(--line);border-radius:8px" />
      <input type="password" name="password" placeholder="Password" required style="padding:10px;border:1px solid var(--line);border-radius:8px" />
      <div id="login-msg" style="color:#b91c1c"></div>
      <button type="submit" class="btn">Log In</button>
    </form>
    <p style="margin-top:14px;font-size:14px">New here? <a href="/account/signup" style="color:var(--brand)">Create an account</a></p>
  </div>
  <script>
    import { getBrowserSupabase } from '../../lib/supabase-browser.js';

    const form = document.getElementById('login-form');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('login-msg');
      msg.textContent = '';
      const fd = new FormData(form);
      const supabase = await getBrowserSupabase();
      const { error } = await supabase.auth.signInWithPassword({
        email: fd.get('email'),
        password: fd.get('password'),
      });
      if (error) {
        msg.textContent = error.message;
        return;
      }
      const params = new URLSearchParams(window.location.search);
      window.location.href = params.get('next') || '/account';
    });
  </script>
</Layout>
