---
import Layout from '../../layouts/Layout.astro';
import { getSupabase, rupees } from '../../lib/supabase.js';

const { slug } = Astro.params;
let p = null;
let debugError = null;
try {
  const supabase = getSupabase();
  const { data, error } = await supabase.from('products').select('*').eq('slug', slug).maybeSingle();
  if (error) throw error;
  p = data;
} catch (e) {
  debugError = (e && (e.message || e.toString())) + (e && e.stack ? '\n' + e.stack : '');
}
const off = p && p.mrp > p.selling_price ? Math.round((1 - p.selling_price / p.mrp) * 100) : 0;
---
<Layout title={p ? `${p.name} | My Electronics Store` : 'Product | My Electronics Store'}>
  {debugError && (
    <pre style="background:#fee2e2;color:#7f1d1d;padding:14px;border-radius:8px;white-space:pre-wrap;font-size:13px;margin-bottom:16px;">DEBUG ERROR — copy this whole box and send it to Claude:{"\n"}{debugError}</pre>
  )}
  <p><a href="/">← All products</a></p>
  {!p && !debugError && <p>Product not found.</p>}
  {p && (
  <div class="detail">
    <div class="img">{p.image_url ? <img src={p.image_url} alt={p.name} /> : 'No image'}</div>
    <div>
      <h1 style="margin-top:0">{p.name}</h1>
      <p style="color:var(--muted)">SKU: {p.sku}{p.brand && ` · Brand: ${p.brand}`}</p>
      <p style="font-size:24px"><span class="price">{rupees(p.selling_price)}</span>
        {off > 0 && <><span class="mrp">{rupees(p.mrp)}</span> <span class="off">{off}% off</span></>}</p>
      <p style="color:var(--muted);font-size:13px">Inclusive of GST</p>
      {p.stock > 0 ? <p style="color:#15803d">In stock ({p.stock} available)</p> : <p class="out">Out of stock</p>}
      {p.short_description && <p>{p.short_description}</p>}
      {p.specifications && <><h3>Specifications</h3><p style="white-space:pre-line">{p.specifications}</p></>}
      {p.datasheet_url && <p><a href={p.datasheet_url} style="color:var(--brand)">Datasheet</a></p>}
      {p.stock > 0 && (
        <div id="add-to-cart" data-product={JSON.stringify({ product_id: p.id, sku: p.sku, name: p.name, price: p.selling_price, image_url: p.image_url })} style="margin-top:16px">
          <input type="number" id="qty" value="1" min="1" max={p.stock} style="width:60px;padding:8px;border:1px solid var(--line);border-radius:8px;margin-right:8px" />
          <button id="add-btn" class="btn">Add to Cart</button>
          <button id="wishlist-btn" data-product-id={p.id} style="margin-left:8px;background:#fff;border:1px solid var(--line);border-radius:8px;padding:10px 14px;cursor:pointer;font-size:16px">♡</button>
          <span id="add-msg" style="margin-left:10px;color:#15803d"></span>
        </div>
      )}
    </div>
  </div>
  )}
  <script>
    import { addToCart } from '../../lib/cart-client.js';
    import { getBrowserSupabase } from '../../lib/supabase-browser.js';

    const wrap = document.getElementById('add-to-cart');
    if (wrap) {
      const product = JSON.parse(wrap.dataset.product);
      document.getElementById('add-btn')?.addEventListener('click', () => {
        const qty = parseInt(document.getElementById('qty').value) || 1;
        addToCart(product, qty);
        const msg = document.getElementById('add-msg');
        msg.textContent = 'Added to cart!';
        setTimeout(() => (msg.textContent = ''), 2000);
      });

      const wishBtn = document.getElementById('wishlist-btn');
      const productId = Number(wishBtn.dataset.productId);
      let inWishlist = false;
      let supabase;

      (async () => {
        supabase = await getBrowserSupabase();
        const {
          data: { session },
        } = await supabase.auth.getSession();
        if (!session) return;
        const { data } = await supabase.from('wishlist').select('id').eq('product_id', productId).maybeSingle();
        if (data) {
          inWishlist = true;
          wishBtn.textContent = '♥';
          wishBtn.style.color = '#b91c1c';
        }
      })();

      wishBtn.addEventListener('click', async () => {
        if (!supabase) supabase = await getBrowserSupabase();
        const {
          data: { session },
        } = await supabase.auth.getSession();
        if (!session) {
          window.location.href = `/account/login?next=${encodeURIComponent(window.location.pathname)}`;
          return;
        }
        if (inWishlist) {
          await supabase.from('wishlist').delete().eq('product_id', productId);
          inWishlist = false;
          wishBtn.textContent = '♡';
          wishBtn.style.color = '';
        } else {
          await supabase.from('wishlist').insert({ product_id: productId, user_id: session.user.id });
          inWishlist = true;
          wishBtn.textContent = '♥';
          wishBtn.style.color = '#b91c1c';
        }
      });
    }
  </script>
</Layout>
