---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us | My Electronics Store">
  <h1>Contact Us</h1>
  <div style="max-width:480px;background:#fff;padding:20px;border-radius:10px;border:1px solid var(--line)">
    <p><b>My Electronics Store</b></p>
    <p>Email: your-email@example.com</p>
    <p>Phone: +91 XXXXX XXXXX</p>
    <p>Hours: Monday–Saturday, 9:00 AM – 6:00 PM</p>
    <p style="color:var(--muted)">Address: [Your business address]</p>
  </div>
  <p style="color:var(--muted);font-size:13px;max-width:480px">
    (Store owner note: replace the placeholder email, phone, and address above in src/pages/contact.astro with your real details.)
  </p>
</Layout>
