---
import Layout from '../layouts/Layout.astro';
import { getSupabase, rupees } from '../lib/supabase.js';

const q = (Astro.url.searchParams.get('q') ?? '').replace(/[,()%*]/g, ' ').trim();
const catId = Number(Astro.url.searchParams.get('cat')) || null;

let cats = [], parents = [], current = null, products = [];
let debugError = null;

try {
  const supabase = getSupabase();
  const { data: catData, error: catErr } = await supabase.from('categories').select('*').order('sort_order');
  if (catErr) throw catErr;
  cats = catData ?? [];
  parents = cats.filter((c) => !c.parent_id);
  current = cats.find((c) => c.id === catId);
  const ids = current ? [current.id, ...cats.filter((c) => c.parent_id === current.id).map((c) => c.id)] : null;

  let query = supabase.from('products').select('id,slug,name,sku,mrp,selling_price,stock,image_url').order('name').limit(60);
  if (ids) query = query.in('category_id', ids);
  if (q) query = query.or(`name.ilike.%${q}%,sku.ilike.%${q}%,brand.ilike.%${q}%`);
  const { data, error: prodErr } = await query;
  if (prodErr) throw prodErr;
  products = data ?? [];
} catch (e) {
  debugError = (e && (e.message || e.toString())) + (e && e.stack ? '\n' + e.stack : '');
}
---
<Layout title={current ? `${current.name} | ROBO9` : 'ROBO9'}>
  {debugError && (
    <pre style="background:#fee2e2;color:#7f1d1d;padding:14px;border-radius:8px;white-space:pre-wrap;font-size:13px;margin-bottom:16px;">DEBUG ERROR — copy this whole box and send it to Claude:{"\n"}{debugError}</pre>
  )}
  {!current && !q && (
    <div class="hero-carousel" id="hero-carousel">
      <div class="hero-track" id="hero-track">
        <a class="hero-slide" href="/" style="background:linear-gradient(120deg,#0b1f3a,#123a7a)">
          <svg class="hero-icon" viewBox="0 0 100 100"><g stroke="#ffffff" stroke-opacity="0.35" stroke-width="3" fill="none"><rect x="30" y="30" width="40" height="40" rx="4"/><line x1="30" y1="40" x2="14" y2="40"/><line x1="30" y1="60" x2="14" y2="60"/><line x1="70" y1="40" x2="86" y2="40"/><line x1="70" y1="60" x2="86" y2="60"/><line x1="40" y1="30" x2="40" y2="14"/><line x1="60" y1="30" x2="60" y2="14"/><line x1="40" y1="70" x2="40" y2="86"/><line x1="60" y1="70" x2="60" y2="86"/></g></svg>
          <div class="hero-text">
            <h2>Welcome to ROBO9</h2>
            <p>500+ sensors, modules, motors & dev boards — everything for your next build.</p>
            <span class="hero-cta">Shop All →</span>
          </div>
        </a>
        <a class="hero-slide" href="/?q=sensor" style="background:linear-gradient(120deg,#0b3d91,#1e6fd9)">
          <svg class="hero-icon" viewBox="0 0 100 100"><g stroke="#ffffff" stroke-opacity="0.35" stroke-width="3" fill="none"><circle cx="50" cy="50" r="14"/><circle cx="50" cy="50" r="26"/><circle cx="50" cy="50" r="38"/></g></svg>
          <div class="hero-text">
            <h2>Sensors & Modules</h2>
            <p>IR, Ultrasonic, PIR, Gas, Temperature & Humidity, and more.</p>
            <span class="hero-cta">Explore Sensors →</span>
          </div>
        </a>
        <a class="hero-slide" href="/?q=motor" style="background:linear-gradient(120deg,#134e4a,#0f9488)">
          <svg class="hero-icon" viewBox="0 0 100 100"><g stroke="#ffffff" stroke-opacity="0.35" stroke-width="3" fill="none"><circle cx="50" cy="50" r="16"/><circle cx="50" cy="50" r="5"/><line x1="50" y1="18" x2="50" y2="28"/><line x1="50" y1="72" x2="50" y2="82"/><line x1="18" y1="50" x2="28" y2="50"/><line x1="72" y1="50" x2="82" y2="50"/><line x1="27" y1="27" x2="34" y2="34"/><line x1="66" y1="66" x2="73" y2="73"/><line x1="73" y1="27" x2="66" y2="34"/><line x1="34" y1="66" x2="27" y2="73"/></g></svg>
          <div class="hero-text">
            <h2>Motors & Drivers</h2>
            <p>DC, servo, stepper & geared motors to power your robotics projects.</p>
            <span class="hero-cta">Explore Motors →</span>
          </div>
        </a>
        <a class="hero-slide" href="/?q=arduino" style="background:linear-gradient(120deg,#3730a3,#6d28d9)">
          <svg class="hero-icon" viewBox="0 0 100 100"><g stroke="#ffffff" stroke-opacity="0.35" stroke-width="3" fill="none"><rect x="20" y="30" width="60" height="40" rx="4"/><circle cx="32" cy="42" r="3" fill="#ffffff" fill-opacity="0.35" stroke="none"/><circle cx="44" cy="42" r="3" fill="#ffffff" fill-opacity="0.35" stroke="none"/><circle cx="56" cy="42" r="3" fill="#ffffff" fill-opacity="0.35" stroke="none"/><circle cx="68" cy="42" r="3" fill="#ffffff" fill-opacity="0.35" stroke="none"/><line x1="30" y1="58" x2="70" y2="58"/></g></svg>
          <div class="hero-text">
            <h2>Development Boards</h2>
            <p>Arduino, ESP32, ESP8266 & more to bring your ideas to life.</p>
            <span class="hero-cta">Explore Boards →</span>
          </div>
        </a>
        <a class="hero-slide" href="/track-order" style="background:linear-gradient(120deg,#7c2d12,#c2410c)">
          <svg class="hero-icon" viewBox="0 0 100 100"><g stroke="#ffffff" stroke-opacity="0.35" stroke-width="3" fill="none"><rect x="14" y="38" width="42" height="24" rx="3"/><path d="M56 46 H76 L86 56 V62 H56 Z"/><circle cx="30" cy="66" r="6"/><circle cx="72" cy="66" r="6"/></g></svg>
          <div class="hero-text">
            <h2>Fast Delivery, Pan-India</h2>
            <p>Pay online or Cash on Delivery — track every order in real time.</p>
            <span class="hero-cta">Track Your Order →</span>
          </div>
        </a>
      </div>
      <button class="hero-arrow hero-prev" id="hero-prev" aria-label="Previous">‹</button>
      <button class="hero-arrow hero-next" id="hero-next" aria-label="Next">›</button>
      <div class="hero-dots" id="hero-dots"></div>
    </div>
  )}
  {!current && !q && (
    <div class="cat-tile-grid" id="cat-tile-grid"></div>
  )}
  <div class="chips">
    <a class={`chip ${!current ? 'on' : ''}`} href="/">All</a>
    {parents.map((c) => <a class={`chip ${current?.id === c.id ? 'on' : ''}`} href={`/?cat=${c.id}`}>{c.name}</a>)}
  </div>
  {q && <p>Results for <b>{q}</b>: {products.length} found</p>}
  {products.length === 0 ? <p>No products found.</p> : (
    <div class="grid">
      {products.map((p) => (
        <div class="card" data-product-id={p.id}>
          <button type="button" class="wishlist-heart" data-product-id={p.id} aria-label="Add to wishlist">♡</button>
          <a class="card-link" href={`/product/${p.slug}`}>
            <div class="img">{p.image_url && <img src={p.image_url} alt={p.name} loading="lazy" />}</div>
            <div class="name">{p.name}</div>
            <div><span class="price">{rupees(p.selling_price)}</span>{p.mrp > p.selling_price && <span class="mrp">{rupees(p.mrp)}</span>}</div>
            {p.stock <= 0 && <div class="out">Out of stock</div>}
          </a>
          {p.stock > 0 && (
            <div
              class="card-cart-row"
              data-product={JSON.stringify({ product_id: p.id, sku: p.sku, name: p.name, price: p.selling_price, image_url: p.image_url })}
            >
              <input type="number" class="card-qty" value="1" min="1" max={p.stock} />
              <button type="button" class="card-add-btn">Add</button>
            </div>
          )}
        </div>
      ))}
    </div>
  )}
</Layout>

<style>
  .hero-carousel { position:relative; border-radius:12px; overflow:hidden; margin-bottom:20px; }
  .hero-track { display:flex; transition:transform 0.5s ease; }
  .hero-slide {
    flex:0 0 100%; height:220px; display:flex; align-items:center; justify-content:space-between;
    padding:24px 32px; color:#fff; position:relative; overflow:hidden; text-decoration:none;
  }
  .hero-icon { width:150px; height:150px; flex-shrink:0; order:2; }
  .hero-text { max-width:420px; order:1; position:relative; z-index:2; }
  .hero-text h2 { margin:0 0 8px; font-size:26px; }
  .hero-text p { margin:0 0 14px; font-size:14px; opacity:0.9; line-height:1.4; }
  .hero-cta { display:inline-block; background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.4); padding:8px 16px; border-radius:8px; font-size:14px; font-weight:600; }
  .hero-arrow {
    position:absolute; top:50%; transform:translateY(-50%); background:rgba(0,0,0,0.25); color:#fff;
    border:0; width:36px; height:36px; border-radius:50%; font-size:20px; cursor:pointer; line-height:1;
  }
  .hero-prev { left:10px; } .hero-next { right:10px; }
  .hero-dots { position:absolute; bottom:12px; left:0; right:0; display:flex; justify-content:center; gap:6px; }
  .hero-dot { width:8px; height:8px; border-radius:50%; background:rgba(255,255,255,0.5); cursor:pointer; border:0; padding:0; }
  .hero-dot.on { background:#fff; }
  @media (max-width:640px) {
    .hero-slide { height:190px; padding:18px 16px; }
    .hero-icon { width:80px; height:80px; }
    .hero-text h2 { font-size:19px; }
    .hero-text p { font-size:12px; }
  }
</style>
<script>
  const track = document.getElementById('hero-track');
  if (track) {
    const slides = track.querySelectorAll('.hero-slide');
    const dotsWrap = document.getElementById('hero-dots');
    let index = 0;
    slides.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'hero-dot' + (i === 0 ? ' on' : '');
      dot.addEventListener('click', () => goTo(i));
      dotsWrap.appendChild(dot);
    });
    function goTo(i) {
      index = (i + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      dotsWrap.querySelectorAll('.hero-dot').forEach((d, di) => d.classList.toggle('on', di === index));
    }
    document.getElementById('hero-prev').addEventListener('click', () => goTo(index - 1));
    document.getElementById('hero-next').addEventListener('click', () => goTo(index + 1));

    let timer = setInterval(() => goTo(index + 1), 4500);
    const carousel = document.getElementById('hero-carousel');
    carousel.addEventListener('mouseenter', () => clearInterval(timer));
    carousel.addEventListener('mouseleave', () => (timer = setInterval(() => goTo(index + 1), 4500)));
  }
</script>

<script>
  import { addToCart } from '../lib/cart-client.js';
  import { getBrowserSupabase } from '../lib/supabase-browser.js';

  // ---------- Shop by Category tiles ----------
  const TILE_STYLES = {
    'Sensors & Modules': {
      bg: 'linear-gradient(135deg,#0b3d91,#1e6fd9)',
      icon: '<circle cx="50" cy="50" r="14"/><circle cx="50" cy="50" r="26"/><circle cx="50" cy="50" r="38"/>',
    },
    'Motors & Drivers': {
      bg: 'linear-gradient(135deg,#134e4a,#0f9488)',
      icon: '<circle cx="50" cy="50" r="16"/><circle cx="50" cy="50" r="5"/><line x1="50" y1="18" x2="50" y2="28"/><line x1="50" y1="72" x2="50" y2="82"/><line x1="18" y1="50" x2="28" y2="50"/><line x1="72" y1="50" x2="82" y2="50"/><line x1="27" y1="27" x2="34" y2="34"/><line x1="66" y1="66" x2="73" y2="73"/><line x1="73" y1="27" x2="66" y2="34"/><line x1="34" y1="66" x2="27" y2="73"/>',
    },
    Components: {
      bg: 'linear-gradient(135deg,#7c2d12,#c2410c)',
      icon: '<line x1="10" y1="50" x2="28" y2="50"/><line x1="72" y1="50" x2="90" y2="50"/><path d="M28 50 L34 38 L42 62 L50 38 L58 62 L66 38 L72 50"/>',
    },
    ICs: {
      bg: 'linear-gradient(135deg,#3730a3,#6d28d9)',
      icon: '<rect x="30" y="30" width="40" height="40" rx="4"/><line x1="30" y1="40" x2="14" y2="40"/><line x1="30" y1="60" x2="14" y2="60"/><line x1="70" y1="40" x2="86" y2="40"/><line x1="70" y1="60" x2="86" y2="60"/><line x1="40" y1="30" x2="40" y2="14"/><line x1="60" y1="30" x2="60" y2="14"/><line x1="40" y1="70" x2="40" y2="86"/><line x1="60" y1="70" x2="60" y2="86"/>',
    },
    'Development Boards': {
      bg: 'linear-gradient(135deg,#0b1f3a,#123a7a)',
      icon: '<rect x="20" y="30" width="60" height="40" rx="4"/><circle cx="32" cy="42" r="3" fill="#ffffff" fill-opacity="0.9" stroke="none"/><circle cx="44" cy="42" r="3" fill="#ffffff" fill-opacity="0.9" stroke="none"/><circle cx="56" cy="42" r="3" fill="#ffffff" fill-opacity="0.9" stroke="none"/><circle cx="68" cy="42" r="3" fill="#ffffff" fill-opacity="0.9" stroke="none"/><line x1="30" y1="58" x2="70" y2="58"/>',
    },
    Power: {
      bg: 'linear-gradient(135deg,#854d0e,#ca8a04)',
      icon: '<rect x="25" y="35" width="45" height="30" rx="3"/><rect x="70" y="45" width="6" height="10"/><line x1="40" y1="42" x2="40" y2="58"/><line x1="55" y1="42" x2="55" y2="58"/>',
    },
  };
  const DEFAULT_TILE = {
    bg: 'linear-gradient(135deg,#374151,#6b7280)',
    icon: '<rect x="30" y="30" width="40" height="40" rx="6"/>',
  };

  async function loadCategoryTiles() {
    const grid = document.getElementById('cat-tile-grid');
    if (!grid) return;
    try {
      const res = await fetch('/api/categories');
      const data = await res.json();
      const parents = data.parents || [];
      grid.innerHTML = parents
        .map((c) => {
          const style = TILE_STYLES[c.name] || DEFAULT_TILE;
          return `<a class="cat-tile" href="/?cat=${c.id}" style="background:${style.bg}">
            <svg viewBox="0 0 100 100" fill="none" stroke="#fff" stroke-width="3" stroke-opacity="0.9">${style.icon}</svg>
            <span>${c.name}</span>
          </a>`;
        })
        .join('');
    } catch {
      grid.remove();
    }
  }
  loadCategoryTiles();

  // ---------- Wishlist hearts on product cards ----------
  async function initWishlistHearts() {
    const hearts = document.querySelectorAll('.wishlist-heart');
    if (hearts.length === 0) return;

    let supabase, session;
    try {
      supabase = await getBrowserSupabase();
      const { data } = await supabase.auth.getSession();
      session = data.session;
    } catch {
      return;
    }
    if (!session) {
      hearts.forEach((h) =>
        h.addEventListener('click', () => {
          window.location.href = `/account/login?next=${encodeURIComponent(window.location.pathname + window.location.search)}`;
        })
      );
      return;
    }

    const { data: rows } = await supabase.from('wishlist').select('product_id');
    const wishedIds = new Set((rows || []).map((r) => String(r.product_id)));

    hearts.forEach((h) => {
      const pid = h.dataset.productId;
      if (wishedIds.has(pid)) {
        h.textContent = '♥';
        h.classList.add('active');
      }
      h.addEventListener('click', async () => {
        const active = h.classList.contains('active');
        if (active) {
          await supabase.from('wishlist').delete().eq('product_id', pid);
          h.textContent = '♡';
          h.classList.remove('active');
        } else {
          await supabase.from('wishlist').insert({ product_id: Number(pid), user_id: session.user.id });
          h.textContent = '♥';
          h.classList.add('active');
        }
      });
    });
  }
  initWishlistHearts();

  // ---------- Inline Add to Cart on product cards ----------
  document.querySelectorAll('.card-cart-row').forEach((row) => {
    const product = JSON.parse(row.dataset.product);
    const qtyInput = row.querySelector('.card-qty');
    const addBtn = row.querySelector('.card-add-btn');
    qtyInput.addEventListener('input', () => {
      const max = parseInt(qtyInput.max) || 9999;
      let val = parseInt(qtyInput.value) || 1;
      if (val < 1) val = 1;
      if (val > max) val = max;
      qtyInput.value = val;
    });
    addBtn.addEventListener('click', () => {
      const qty = parseInt(qtyInput.value) || 1;
      addToCart(product, qty);
      addBtn.textContent = 'Added ✓';
      addBtn.classList.add('added');
      setTimeout(() => {
        addBtn.textContent = 'Add';
        addBtn.classList.remove('added');
      }, 1500);
    });
  });
</script>
