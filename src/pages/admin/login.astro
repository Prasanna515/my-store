---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Admin Login">
  <div style="max-width:360px;margin:60px auto;background:#fff;padding:24px;border-radius:10px;border:1px solid var(--line)">
    <h1>Admin Login</h1>
    <form id="login-form" style="display:flex;flex-direction:column;gap:10px">
      <input type="password" name="password" placeholder="Admin password" required style="padding:10px;border:1px solid var(--line);border-radius:8px" />
      <div id="login-msg" style="color:#b91c1c"></div>
      <button type="submit" class="btn">Log In</button>
    </form>
  </div>
  <script>
    const form = document.getElementById('login-form');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('login-msg');
      msg.textContent = '';
      const fd = new FormData(form);
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: fd.get('password') }),
      });
      const data = await res.json();
      if (!res.ok) {
        msg.textContent = data.error || 'Login failed.';
        return;
      }
      window.location.href = '/admin';
    });
  </script>
</Layout>
